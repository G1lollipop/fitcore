# Repo-root fallback ignores (apply to the whole monorepo).
# web/ and rag/ each maintain their own finer-grained .gitignore; both stack.

# ---- OS ----
.DS_Store
Thumbs.db

# ---- Editor / IDE ----
.idea/
.vscode/
*.swp
*.swo
*~

# ---- Agent / local tooling ----
.claude/
# Note: environment.json, rules, etc. under .cursor/ are meant to be committed and shared, so don't ignore the whole folder.

# ---- Environment variables / secrets (never commit) ----
.env
.env.*
!.env.example
!.env.local.example

# OAuth / service-account key files (Google-downloaded client_secret, etc. — never commit)
client_secret*.json
**/client_secret*.json
*-service-account*.json
gha-creds-*.json

# ---- Node / frontend ----
**/node_modules/
**/.next/
**/out/
**/dist/
**/build/
**/.vercel/
**/*.tsbuildinfo
**/next-env.d.ts
.eslintcache

# ---- Python / backend ----
**/.venv/
**/venv/
**/__pycache__/
**/*.py[cod]
.pytest_cache/
.ruff_cache/

# ---- RAG runtime artifacts ----
**/chroma/
**/chat_history/
**/md5.text
# Eval run artifacts (retrieval / faithfulness / abstention / agent reports — never committed)
**/eval/*_report_*.json

# ---- Bulk-harvested open-access full text: large, reproducible via
#      rag/scripts/harvest_kb.py, so not version-controlled (the source
#      manifest data/harvested_sources.json is still committed for traceability) ----
rag/data/auto_epmc_*.txt
# Temporary cloud "remaining list" for incremental ingest (recomputed from Supabase state — not committed)
rag/data/cloud_remaining.txt

# ---- Logs / misc local files ----
*.local
*.log
logs/

# ---- Lockfiles (currently not version-controlled) ----
package-lock.json
pnpm-lock.yaml
yarn.lock

# ---- Personal learning / planning docs (kept locally, not published) ----
docs/mle/
rag/eval/P0_PLAN.md
