{
  "$schema": "https://raw.githubusercontent.com/microsoft/pyright/main/packages/vscode-pyright/schema/pyrightconfig.schema.json",
  "include": ["rag"],
  "exclude": [
    "**/.venv",
    "**/venv",
    "**/__pycache__",
    "**/node_modules",
    "**/.next",
    "**/out",
    "**/dist",
    "**/build",
    "**/.opencode",
    "**/.vercel",
    "**/chroma",
    "**/data",
    "**/docs",
    "**/scripts",
    "**/eval",
    "**/training",
    "**/tests",
    "**/parsers",
    "**/supabase",
    "**/.claude",
    "**/.idea",
    "**/.vscode",
    "**/.pytest_cache",
    "**/.ruff_cache"
  ],
  "typeCheckingMode": "basic",
  "reportMissingImports": "none",
  "reportMissingTypeStubs": "none",
  "useLibraryCodeForTypes": true
}
