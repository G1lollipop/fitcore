# Required for Gemini-backed chat AND embeddings (one key powers both).
# Obtain at https://aistudio.google.com/apikey.
# GEMINI_API_KEY / DASHSCOPE_API_KEY are also accepted for backward compat.
GOOGLE_AI_STUDIO_API_KEY=your_google_ai_studio_key
RAG_CHAT_MODEL=gemini-2.5-flash

# Optional: override the OpenAI-compatible chat endpoint. Default is Gemini's.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Embeddings (Gemini). EMBEDDING_DIM MUST equal the Supabase migration's
# vector(N). gemini-embedding-001 supports Matryoshka truncation; 768 is the
# default and keeps the pgvector index small. Run scripts/print_embedding_dim.py
# to verify the actual dimension.
EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIM=768

# Chunking strategy at ingest time:
#   recursive = fast char-based RecursiveCharacterTextSplitter (DEFAULT)
#   semantic  = embedding-based SemanticChunker (splits at meaning shifts)
#     ⚠️ semantic embeds every sentence and easily exceeds the Gemini FREE-tier
#     embedding limit (100 req/min → 429). Use only on a paid tier / tiny corpus.
CHUNKING_STRATEGY=recursive
# percentile | standard_deviation | interquartile | gradient  (semantic only)
SEMANTIC_BREAKPOINT_TYPE=percentile

# Optional: point to a local reranker model directory.
# Leave blank for now and the service will fall back to base retrieval.
RERANKER_MODEL_PATH=

# Optional: HuggingFace hub model id (recommended if you don't have a local snapshot)
# Example: BAAI/bge-reranker-base
RERANKER_MODEL_NAME=

# Optional: extra kwargs for sentence_transformers.CrossEncoder, as JSON
# Example: {"local_files_only": true, "trust_remote_code": false, "device": "cpu"}
RERANKER_MODEL_KWARGS=

# Reranker on/off — controls the dual-mode retrieval pipeline.
#   true  : Vector + BM25 + CrossEncoder rerank (本地开发推荐)
#   false : Base retrieval only (Vector + BM25 ensemble)
# Cloud deployments (Render / 内存受限的容器) 必须设为 false —
# bge-reranker-base 在 512MB 实例上会 OOM。requirements-prod.txt 也不安装
# torch / sentence-transformers，所以即使误开为 true 也会自动降级到 base。
RERANKER_ENABLED=true

# Optional: HuggingFace Hub mirror / endpoint (helpful in some network environments)
# Example (mirror): https://hf-mirror.com
HF_ENDPOINT=

# Optional: local frontend origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: model used by eval/evaluate.py as LLM-as-Judge.
EVAL_JUDGE_MODEL=gemini-2.5-flash

# --- Vector store: Chroma (default) or Supabase pgvector ---
# chroma = 本地 ./chroma 目录；supabase = 线上 Postgres + pgvector（需先执行 Rag/supabase/migrations/*.sql）
VECTOR_BACKEND=chroma

# Supabase（仅 VECTOR_BACKEND=supabase 时必填；使用 service_role，勿提交到仓库）
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# 灌库前请运行: python scripts/print_embedding_dim.py
# 若 actual_dim 不是 768，请把 supabase/migrations 里 vector(768) 改成你的维度（或调 EMBEDDING_DIM）后重新建表/RPC。
# 从 Chroma 改到 Supabase 后若 ingest 一直「跳过」，请执行: python scripts/ingest_seed_kb.py --force
#
# 若本机报 getaddrinfo failed / DNS 超时，可二选一：
# 1) 配置系统或终端可用的 HTTP 代理（httpx 会读环境变量）：
#    HTTPS_PROXY=http://127.0.0.1:7890
#    HTTP_PROXY=http://127.0.0.1:7890
# 2) 使用仓库 .github/workflows/rag-supabase-ingest.yml 在 GitHub Actions 上灌库（见该文件顶部说明）
