# Required for Gemini-backed chat AND embeddings (one key powers both).
# Obtain at https://aistudio.google.com/apikey.
# GEMINI_API_KEY / DASHSCOPE_API_KEY are also accepted for backward compat.
GOOGLE_AI_STUDIO_API_KEY=your_google_ai_studio_key
RAG_CHAT_MODEL=gemini-2.5-flash

# Optional: override the OpenAI-compatible chat endpoint. Default is Gemini's.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# ── Embeddings provider (dual-track) ──────────────────────────────────────
#   gemini (DEFAULT) → cloud API embeddings, 768-dim, matches Supabase vector(768).
#                      Used for the deployed/cloud track (free-tier friendly).
#   local            → on-device sentence-transformers (no API quota). Pair with
#                      VECTOR_BACKEND=chroma for the full-corpus local learning
#                      track. Needs: pip install "torch>=2.7" sentence-transformers
#                      langchain-huggingface. Query & ingest MUST use the same
#                      provider/model (shared embedding space) — switching means re-ingest.
EMBEDDING_PROVIDER=gemini

# Gemini track. EMBEDDING_DIM MUST equal the Supabase migration's vector(N).
# gemini-embedding-001 supports Matryoshka truncation; 768 keeps the index small.
EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIM=768

# Local track (only used when EMBEDDING_PROVIDER=local).
# bge-large-en-v1.5 = 1024-dim, strong English retrieval. EMBEDDING_DEVICE:
# auto (cuda if available else cpu) | cuda | cpu.
LOCAL_EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DEVICE=auto

# Chunking size (char-based recursive splitter). Defaults 1000/100 (fine-grained,
# good for the local full-corpus track). For the cloud track, raise CHUNK_SIZE
# (e.g. 3500) to cut chunk count → fewer Gemini embeds + less Supabase storage.
CHUNK_SIZE=1000
CHUNK_OVERLAP=100

# ── Two ready-to-use profiles ─────────────────────────────────────────────
# Local learning track (full 1070 docs, no quota):
#   EMBEDDING_PROVIDER=local
#   VECTOR_BACKEND=chroma
#   CHUNK_SIZE=1000
#   (HF_HOME=D:\models\hf to control where bge weights download)
#   python scripts/ingest_seed_kb.py --force
#
# Cloud deploy track (~250 curated docs, Gemini+Supabase free):
#   EMBEDDING_PROVIDER=gemini
#   VECTOR_BACKEND=supabase
#   CHUNK_SIZE=3500
#   python scripts/prune_cloud_kb.py --target 250
#   python scripts/ingest_seed_kb.py --keep-list data/cloud_keep.txt --force

# Chunking strategy at ingest time:
#   recursive = fast char-based RecursiveCharacterTextSplitter (DEFAULT)
#   semantic  = embedding-based SemanticChunker (splits at meaning shifts)
#     ⚠️ semantic embeds every sentence and easily exceeds the Gemini FREE-tier
#     embedding limit (100 req/min → 429). Use only on a paid tier / tiny corpus.
CHUNKING_STRATEGY=recursive
# percentile | standard_deviation | interquartile | gradient  (semantic only)
SEMANTIC_BREAKPOINT_TYPE=percentile

# Optional: point to a local reranker model directory.
# Leave blank for now and the service will fall back to base retrieval.
RERANKER_MODEL_PATH=

# Optional: HuggingFace hub model id (recommended if you don't have a local snapshot)
# Example: BAAI/bge-reranker-base
RERANKER_MODEL_NAME=

# Optional: extra kwargs for sentence_transformers.CrossEncoder, as JSON
# Example: {"local_files_only": true, "trust_remote_code": false, "device": "cpu"}
RERANKER_MODEL_KWARGS=

# Reranker on/off — controls the dual-mode retrieval pipeline.
#   true  : Vector + BM25 + CrossEncoder rerank (recommended for local development)
#   false : Base retrieval only (Vector + BM25 ensemble)
# Cloud deployments (Render / memory-constrained containers) MUST set this to false —
# bge-reranker-base will OOM on a 512MB instance. requirements-prod.txt also does
# not install torch / sentence-transformers, so even if accidentally set to true it
# automatically falls back to base.
RERANKER_ENABLED=true

# Optional: HuggingFace Hub mirror / endpoint (helpful in some network environments)
# Example (mirror): https://hf-mirror.com
HF_ENDPOINT=

# Optional: local frontend origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: model used by eval/evaluate.py as LLM-as-Judge.
EVAL_JUDGE_MODEL=gemini-2.5-flash

# --- Vector store: Chroma (default) or Supabase pgvector ---
# chroma = local ./chroma directory; supabase = hosted Postgres + pgvector (run rag/supabase/migrations/*.sql first)
VECTOR_BACKEND=chroma

# Supabase (required only when VECTOR_BACKEND=supabase; uses service_role, do not commit to the repo)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Before ingesting, run: python scripts/print_embedding_dim.py
# If actual_dim is not 768, change vector(768) in supabase/migrations to your dimension (or adjust EMBEDDING_DIM) and recreate the table/RPC.
# After switching from Chroma to Supabase, if ingest keeps "skipping", run: python scripts/ingest_seed_kb.py --force
#
# If your machine reports getaddrinfo failed / DNS timeout, you have two options:
# 1) Configure an HTTP proxy available to the system or terminal (httpx reads environment variables):
#    HTTPS_PROXY=http://127.0.0.1:7890
#    HTTP_PROXY=http://127.0.0.1:7890
# 2) Use the repo's .github/workflows/rag-supabase-ingest.yml to ingest on GitHub Actions (see the notes at the top of that file)
