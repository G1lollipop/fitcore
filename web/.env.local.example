# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_SECRET_KEY=your_clerk_secret_key

# Supabase
# URL is not a secret; the key below is the SERVICE-ROLE key and is used
# server-side only (server actions + middleware). It bypasses RLS, so it must
# NEVER be exposed to the browser. The anon key is no longer used by the web app.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Internal RAG service URL used by the server-side API proxy
RAG_SERVICE_URL=http://127.0.0.1:8000

# Optional: increase if first RAG calls are slow (cold start / model init)
RAG_CLIENT_TIMEOUT_MS=120000

# Optional: /api/ai/chat 响应 meta 中附带 retrievalBackend（与 RAG 部署的 VECTOR_BACKEND 一致时填 supabase 或 chroma）
AI_CHAT_DEBUG_META=0
RAG_VECTOR_BACKEND=supabase

# Optional for older AI flows still present in the app
OPENAI_API_KEY=your_openai_or_dashscope_compatible_key
AI_CHAT_MODEL=qwen3.5-flash
AI_FAST_MODEL=qwen3.5-flash

# Google AI Studio (Gemini) — used by the meal-photo vision tool only.
# Obtain at https://aistudio.google.com/apikey. Server-side only; never expose to the browser.
GOOGLE_AI_STUDIO_API_KEY=your_google_ai_studio_key
# Optional: override the default vision model.
GEMINI_VISION_MODEL=gemini-2.5-flash
