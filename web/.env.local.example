# Supabase
# Auth + data both run on Supabase now.
#  - URL + ANON key: public, used by the cookie-bound auth client (sign-in /
#    sign-up / Google OAuth, session resolution in middleware & server).
#  - SERVICE-ROLE key: secret, server-side only (server actions + middleware).
#    It bypasses RLS, so it must NEVER be exposed to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Google OAuth + email/password are configured in the Supabase Dashboard
# (Authentication → Providers). Add http://localhost:3000/auth/callback and your
# production <domain>/auth/callback to the allowed redirect URLs.

# Internal RAG service URL used by the server-side API proxy
RAG_SERVICE_URL=http://127.0.0.1:8000

# Optional: increase if first RAG calls are slow (cold start / model init)
RAG_CLIENT_TIMEOUT_MS=120000

# Optional: include retrievalBackend in /api/ai/chat response meta (set to supabase or chroma to match the RAG deployment's VECTOR_BACKEND)
AI_CHAT_DEBUG_META=0
RAG_VECTOR_BACKEND=supabase

# Google AI Studio (Gemini) — powers ALL AI features now: coach chat, food /
# workout / quick-log parsing, onboarding advice AND the meal-photo vision tool.
# One key for everything. Obtain at https://aistudio.google.com/apikey.
# Server-side only; never expose to the browser.
GOOGLE_AI_STUDIO_API_KEY=your_google_ai_studio_key

# Text models (coach chat + structured parsing). Default to Gemini Flash.
AI_CHAT_MODEL=gemini-2.5-flash
AI_FAST_MODEL=gemini-2.5-flash

# Optional: override the vision model used by the meal-photo tool.
GEMINI_VISION_MODEL=gemini-2.5-flash

# Optional: point the chat/parsing client at a different OpenAI-compatible
# provider instead of Gemini. When set, these override the Gemini defaults.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
