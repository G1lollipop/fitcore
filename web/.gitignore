# Scripts: ignore one-off local scripts by default, but keep version-controlled
# maintenance scripts. Use `scripts/*` (not `scripts/`) so the `!` exceptions
# below take effect — files inside a fully ignored directory can't be re-included.
scripts/*
!scripts/backfill-exercise-name-en.mjs

# Supabase CLI local config/migrations only (anchored to web root so it does
# NOT swallow source dirs like lib/supabase/).
/supabase/

